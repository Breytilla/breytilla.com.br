# Public application URL used in confirmation links and email assets.
APP_URL=https://breytilla.com.br

# Supabase runtime connection. In Dashboard > Connect, copy the Transaction
# Pooler URI (port 6543). This app disables prepared statements for PgBouncer.
DATABASE_URL=postgresql://postgres.project-ref:url_encoded_password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Used only by `npm run db:migrate`. Copy the Supabase Direct connection or
# Session Pooler URI (port 5432); never use the Transaction Pooler here.
DATABASE_MIGRATION_URL=postgresql://postgres.project-ref:url_encoded_password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# When the Supabase Vercel integration is enabled, POSTGRES_URL and
# POSTGRES_URL_NON_POOLING are accepted automatically instead of the two names
# above. The current app does not need Supabase publishable/anon, secret, or
# service-role API keys because it does not use Auth, Storage, or the Data API.

# Keep the two Resend credentials separate and server-only.
RESEND_TRANSACTIONAL_API_KEY=re_transactional_key
RESEND_MARKETING_API_KEY=re_marketing_key
RESEND_WEBHOOK_SECRET=whsec_webhook_secret

# Verified sender identities.
EMAIL_TRANSACTIONAL_FROM="Breytilla <notificacoes@notificacoes.breytilla.com.br>"
EMAIL_MARKETING_FROM="Breytilla <conteudos@conteudos.breytilla.com.br>"
EMAIL_REPLY_TO=psibreytillak@gmail.com
EMAIL_INTERNAL_TO=psibreytillak@gmail.com

# Provision these once in Resend and keep their identifiers in configuration.
RESEND_MARKETING_TOPIC_ID=topic_id
RESEND_MARKETING_SEGMENT_ID=segment_id

# Protects the internal outbox dispatcher endpoint.
CRON_SECRET=replace_with_at_least_32_random_characters

# Stable secret used to encrypt queued template data. Do not rotate while rows are pending.
EMAIL_OUTBOX_ENCRYPTION_KEY=replace_with_a_different_32_character_secret

# Private administration. The route keyword only hides the entry from casual discovery;
# authentication still requires the username, scrypt password hash and server-side session.
ADMIN_ROUTE_KEY=escolha-uma-palavra-discreta
ADMIN_USERNAME=seu-email-de-acesso@example.com
ADMIN_DISPLAY_NAME=Breytilla
ADMIN_PASSWORD_HASH=scrypt.32768.8.1.replace_with_salt.replace_with_hash
ADMIN_SESSION_SECRET=replace_with_a_third_random_32_character_secret
